#
# Package config for the standalone GL module. Written for a consumer that
# only wants GL, not the media framework:
#
#   find_package(xmedia_gl REQUIRED)
#   target_link_libraries(my_app PRIVATE xmedia::gl)
#
# The target brings its own include root, so sources keep writing
# "render/gl/gl_api.h". xmedia_gl has no dependencies of its own, which is why
# this file has nothing to find_package() on the consumer's behalf.

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/xmedia-kitGlTargets.cmake")

check_required_components(xmedia_gl)
