# find_package(xmedia-kit) config, generated by cmake/XmediaInstall.cmake.
#
# @PACKAGE_INIT@ expands to the relocatable path helpers CMake needs; the
# FFmpeg requirement is frozen in at BUILD time (@XMEDIA_WITH_FFMPEG@) so the
# package describes the tree it was made from instead of guessing.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported targets reference FFmpeg::* IMPORTED targets, and CMake has no
# built-in FindFFmpeg -- the module ships beside this file (see
# XmediaInstall.cmake), so look here before the default module path.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Threads is the only always-on dependency (base/task runs a TaskQueue per
# player thread; find_package(Threads) is REQUIRED in the top-level build).
find_dependency(Threads)

# A build with XMEDIA_ENABLE_FFMPEG=ON exported xmedia_ffmpeg's symbols, so
# the consumer needs the same FFmpeg components this build linked. A build
# with it OFF (the no-ffmpeg gate, design goal G2) needs nothing. libyuv
# travels with FFmpeg: xmedia_ffmpeg's link interface names libyuv::libyuv
# (pixel conversion), and it is found by the module shipped beside this file.
if(@XMEDIA_WITH_FFMPEG@)
  find_dependency(FFmpeg COMPONENTS avformat avcodec avutil swscale swresample
                             avfilter)
  find_dependency(Libyuv)
endif()

# Same freeze for the curl transport: a build with XMEDIA_ENABLE_CURL=ON
# exported xmedia_curl, and CMake's built-in FindCURL satisfies it.
set(XMEDIA_WITH_CURL "@XMEDIA_ENABLE_CURL@")
if(XMEDIA_WITH_CURL)
  find_dependency(CURL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/xmedia-kitTargets.cmake")

check_required_components(xmedia-kit)
