    "text_secondary": "#475569",
    "accent": "#0055FF",
    "line": "#CBD5E1",
    "glow": "rgba(0, 85, 255, 0.08)"
  },
  "typography": {
    "display": {"family": "Inter, system-ui, sans-serif", "size_vh": 8.2, "weight": 800, "line_height": 1.08, "tracking": "-0.025em"},
