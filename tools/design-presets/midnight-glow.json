{
  "name": "midnight-glow",
  "description": "暗夜霓虹科技风：深靛夜空底色 + 冰蓝发光强调 + 极细科技网格感，适合 SaaS/AI/开发者工具",
  "source": "灵感源自 HyperFrames SaaS/Developer Tech 美学方向（本地确定性重制）",
  "colors": {
    "bg_primary": "#0A0E1A",
    "bg_secondary": "#12192E",
    "text_primary": "#F4F7FB",
    "text_secondary": "#94A3B8",
    "accent": "#38BDF8",
    "line": "#1E293B",
    "glow": "rgba(56, 189, 248, 0.16)"
  },
  "typography": {
    "display": {"family": "Inter, system-ui, sans-serif", "size_vh": 8.6, "weight": 800, "line_height": 1.06, "tracking": "-0.03em"},
    "h1": {"family": "Inter, system-ui, sans-serif", "size_vh": 5.6, "weight": 800, "line_height": 1.12},
    "h2": {"family": "Inter, system-ui, sans-serif", "size_vh": 3.8, "weight": 700, "line_height": 1.18},
    "stat_figure": {"family": "Inter, system-ui, sans-serif", "size_vh": 14.0, "weight": 900, "line_height": 1.0},
    "label": {"family": "ui-monospace, Menlo, monospace", "px": 14, "weight": 600, "tracking": "2.4px", "upper": true, "color": "accent"},
    "body": {"family": "Inter, system-ui, sans-serif", "size_vh": 2.9, "weight": 400, "line_height": 1.55, "color": "text_secondary"}
  },
  "spacing": {"pad_x": "8cqw", "pad_y": "6cqw"},
  "components": {
    "hairline": "0.18vh solid {colors.accent}",
