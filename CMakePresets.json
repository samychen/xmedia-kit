{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "XMEDIA_BUILD_TESTS": "ON",
        "XMEDIA_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "XMEDIA_ENABLE_FFMPEG": "ON",
        "XMEDIA_STRICT_WARNINGS": "ON",
        "XMEDIA_WERROR": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "XMEDIA_ENABLE_LTO": "ON",
        "XMEDIA_ENABLE_DCHECK": "OFF",
        "XMEDIA_BUILD_TESTS": "OFF",
        "XMEDIA_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "no-ffmpeg",
      "inherits": "base",
      "displayName": "Core only - no FFmpeg needed",
      "cacheVariables": {
        "XMEDIA_ENABLE_FFMPEG": "OFF"
      }
    },
    {
      "name": "ffmpeg",
      "inherits": "default",
      "displayName": "System FFmpeg (distro packages), no window system",
      "cacheVariables": {
        "XMEDIA_ENABLE_FFMPEG": "ON"
      }
    },
    {
      "name": "linux-sdl2",
      "inherits": "default",
      "cacheVariables": {
        "XMEDIA_ENABLE_FFMPEG": "ON",
        "XMEDIA_ENABLE_SDL2": "ON",
        "XMEDIA_ENABLE_LINUX_NATIVE": "OFF"
      }
    },
    {
      "name": "macos-sdl2",
      "inherits": "default",
      "displayName": "macOS windowed player (SDL2); see docs/12 4.2",
      "cacheVariables": {
        "XMEDIA_ENABLE_FFMPEG": "ON",
        "XMEDIA_ENABLE_SDL2": "ON"
      }
    },
    {
      "name": "capi",
      "inherits": "default",
      "displayName": "C ABI enabled (docs/08 M15); ctest proves the C boundary",
      "cacheVariables": {
        "XMEDIA_ENABLE_FFMPEG": "ON",
        "XMEDIA_ENABLE_CAPI": "ON"
      }
    },
    {
      "name": "qt",
      "inherits": "default",
      "displayName": "Qt Quick host app + qt_unittests (Qt 6.4+; no FFmpeg, no display)",
      "cacheVariables": {
        "XMEDIA_ENABLE_FFMPEG": "OFF",
        "XMEDIA_ENABLE_QT": "ON",
        "XMEDIA_BUILD_QT_PLAYER": "ON"
      }
    },
    {
      "name": "linux-native",
      "inherits": "default",
      "cacheVariables": {
        "XMEDIA_ENABLE_LINUX_NATIVE": "ON",
        "XMEDIA_ENABLE_SDL2": "OFF"
      }
    },
    {
      "name": "linux-all",
      "inherits": "default",
      "cacheVariables": {
        "XMEDIA_ENABLE_LINUX_NATIVE": "ON",
        "XMEDIA_ENABLE_SDL2": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "cacheVariables": {
        "XMEDIA_SANITIZERS": "address;undefined",
        "XMEDIA_WERROR": "OFF"
      }
    },
    {
      "name": "tsan",
      "inherits": "debug",
      "cacheVariables": {
        "XMEDIA_SANITIZERS": "thread",
        "XMEDIA_WERROR": "OFF"
      }
    },
    {
      "name": "ubsan",
      "inherits": "debug",
      "cacheVariables": {
        "XMEDIA_SANITIZERS": "undefined",
        "XMEDIA_WERROR": "OFF"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "cacheVariables": {
        "XMEDIA_COVERAGE": "ON",
        "XMEDIA_WERROR": "OFF"
      }
    },
    {
      "name": "android-arm64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-21",
        "ANDROID_STL": "c++_shared",
        "XMEDIA_ENABLE_ANDROID": "ON",
        "XMEDIA_ENABLE_FFMPEG": "ON",
        "XMEDIA_FFMPEG_ROOT": "${sourceDir}/prebuilt/ffmpeg/android/arm64-v8a",
        "XMEDIA_BUILD_TESTS": "OFF",
        "XMEDIA_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "linux-ffmpeg711",
      "inherits": "default",
      "displayName": "FFmpeg 7.1.1 pinned via XMEDIA_FFMPEG_ROOT",
      "cacheVariables": {
        "XMEDIA_ENABLE_FFMPEG": "ON",
        "XMEDIA_FFMPEG_ROOT": "$env{XMEDIA_FFMPEG_ROOT}"
      }
    },
    {
      "name": "full",
      "inherits": "macos-sdl2",
      "displayName": "Everything: FFmpeg + SDL2 player + tests + examples + fuzz",
      "cacheVariables": {
        "XMEDIA_BUILD_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "no-ffmpeg",
      "configurePreset": "no-ffmpeg"
    },
    {
      "name": "ffmpeg",
      "configurePreset": "ffmpeg"
    },
    {
      "name": "linux-sdl2",
      "configurePreset": "linux-sdl2"
    },
    {
      "name": "macos-sdl2",
      "configurePreset": "macos-sdl2"
    },
    {
      "name": "capi",
      "configurePreset": "capi"
    },
    {
      "name": "qt",
      "configurePreset": "qt"
    },
    {
      "name": "linux-native",
      "configurePreset": "linux-native"
    },
    {
      "name": "linux-all",
      "configurePreset": "linux-all"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "linux-ffmpeg711",
      "configurePreset": "linux-ffmpeg711"
    },
    {
      "name": "full",
      "configurePreset": "full",
      "displayName": "Build everything (full preset)"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false,
        "jobs": 8
      }
    },
    {
      "name": "no-ffmpeg",
      "configurePreset": "no-ffmpeg",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "needs-ffmpeg"
        }
      }
    },
    {
      "name": "ffmpeg",
      "configurePreset": "ffmpeg",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qt",
      "configurePreset": "qt",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "needs-ffmpeg"
        }
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "no-tsan"
        }
      }
    }
  ]
}
